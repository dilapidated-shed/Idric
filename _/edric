#!/bin/sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
toolchain_dir=${EDRIC_TOOLCHAIN_DIR:-"$repo_root/.tools"}
scheme="$toolchain_dir/bin/scheme"
make_command=${MAKE:-make}

# Bootstrap stage 2 runs the compiler produced by stage 1. That compiler
# invokes its Chez backend as `scheme`, so the private pinned toolchain must be
# visible on PATH as well as passed to the stage-1 make invocation.
CHEZ="$scheme"
export CHEZ
PATH="$toolchain_dir/bin:$PATH"
export PATH

usage() {
	cat <<'USAGE'
usage: ./_/edric [scheme|bootstrap|test|all]
       ./_/edric test --only TEST_FILTER
       ./_/edric --emit-one-step SOURCE -o ARTIFACT

  scheme           install the pinned threaded Chez Scheme under .tools
  bootstrap        install Chez Scheme, then bootstrap Idris 2
  test             run the focused Edric handoff test with an existing build
                   or run one test selected by --only
  --emit-one-step  typecheck SOURCE and emit the deterministic ANF handoff
  all              install Chez Scheme, bootstrap Idris 2, and run the handoff test

With no command, all is used.
USAGE
}

install_scheme() {
	EDRIC_TOOLCHAIN_DIR="$toolchain_dir" "$repo_root/scripts/ensure-chez.sh" >/dev/null
}

bootstrap() {
	install_scheme
	"$make_command" -C "$repo_root" bootstrap SCHEME="$scheme"
}

run_test() {
	test_filter=$1
	"$make_command" -C "$repo_root" test only="$test_filter"
}

smoke_test() {
	run_test idris2/basic/edric001
	run_test idris2/basic/edric002
	run_test idris2/basic/edric003
	run_test idris2/basic/edric004
	run_test idris2/basic/edric005
	run_test idris2/basic/edric006
	run_test idris2/basic/edric007
	run_test idris2/basic/edric009
	sh "$repo_root/scripts/test-one-step-emitter.sh"
}

command=${1:-all}
if [ "$#" -gt 0 ]; then
	shift
fi

case "$command" in
scheme)
	[ "$#" -eq 0 ] || { usage >&2; exit 2; }
	install_scheme
	printf '%s\n' "$scheme"
	;;
bootstrap)
	[ "$#" -eq 0 ] || { usage >&2; exit 2; }
	bootstrap
	;;
test)
	case "$#" in
	0)
		smoke_test
		;;
	2)
		if [ "$1" != "--only" ] || [ "$2" = "" ]; then
			usage >&2
			exit 2
		fi
		run_test "$2"
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	;;
--emit-one-step)
	[ "$#" -eq 3 ] || { usage >&2; exit 2; }
	exec sh "$repo_root/scripts/emit-one-step.sh" "$@"
	;;
all)
	[ "$#" -eq 0 ] || { usage >&2; exit 2; }
	bootstrap
	smoke_test
	;;
-h | --help | help)
	[ "$#" -eq 0 ] || { usage >&2; exit 2; }
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
