. ../../../testutils.sh

expect_float16_warning() {
    source="$1"
    requested="$2"
    if ! output=$(idris2_no_clean --check "$source" 2>&1); then
        printf '%s\n' "$output"
        echo "Idriç float coercion did not compile: $source"
        exit 1
    fi
    if ! printf '%s\n' "$output" | grep -F "requested $requested; running this as Float16" >/dev/null; then
        printf '%s\n' "$output"
        echo "missing Float16 coercion warning for $requested"
        exit 1
    fi
}

expect_no_float16_warning() {
    source="$1"
    if ! output=$(idris2_no_clean --check "$source" 2>&1); then
        printf '%s\n' "$output"
        echo "canonical Float16 source did not compile: $source"
        exit 1
    fi
    if printf '%s\n' "$output" | grep -F "running this as Float16" >/dev/null; then
        printf '%s\n' "$output"
        echo "canonical Float16 unexpectedly warned: $source"
        exit 1
    fi
}

expect_float16_warning WideDouble.idric Double
expect_float16_warning WideFloat.idric Float
expect_float16_warning WideFloat32.idric Float32
expect_float16_warning WideFloat64.idric Float64

expect_no_float16_warning CanonicalFloat16.idric
expect_no_float16_warning Decimal.idric

# The internal primitive Float is the carrier below the Prelude's Float16
# wrapper. Prove the restored primitive arithmetic actually executes before
# relying on it for binary16 quantization.
primitive=$(run PrimitiveFloat.idr)
if [ "$primitive" != "primitive-float: PASS" ]; then
    printf '%s\n' "$primitive"
    echo "primitive Float carrier arithmetic failed"
    exit 1
fi

rounding=$(run Float16Rounding.idric)
if [ "$rounding" != "float16-rounding: PASS" ]; then
    printf '%s\n' "$rounding"
    echo "Float16 arithmetic did not round at the binary16 operation boundary"
    exit 1
fi

# Ordinary .idr remains ordinary Idris: its inherited Double is not rewritten
# and receives no Idriç narrowing warning.
check IdrisDouble.idr >/dev/null


human_display=$(run HumanDisplay.idric)
if [ "$human_display" != "½ ³⁄₂ ¹⁄₁₆" ]; then
    printf '%s\n' "$human_display"
    echo "Float16 interpolation did not use vulgar dyadic fractions"
    exit 1
fi
